# Переменные окружения для Docker Compose
# Для первого запуска скопируй в .env.docker:
# cp .env.docker.example .env.docker

# PostgreSQL в Docker Compose доступен по имени сервиса, не по 127.0.0.1
DB_HOST=db
DB_PORT=5432
DB_NAME=deltarune_forum_db
DB_USER=forum_user
DB_PASSWORD=12345

# Django configuration
DEBUG=True
SECRET_KEY=django-insecure-change-me-in-production

# Allowed hosts for Docker
ALLOWED_HOSTS=127.0.0.1,localhost,web
